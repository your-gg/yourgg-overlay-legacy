{
  "name": "@your-gg/yourgg-overlay",
  "version": "1.0.0",
  "description": "YOUR.GG overlay Electron integration",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "author": "storycraft <storycraft@pancake.sh>",
  "homepage": "https://github.com/your-gg/yourgg-overlay#readme",
  "license": "MIT OR Apache-2.0",
  "bugs": {
    "url": "https://github.com/your-gg/yourgg-overlay/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-gg/yourgg-overlay"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build:dist": "tsc",
    "build": "npm run build:dist"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@your-gg/yourgg-core": "workspace:*",
    "electron": "^40.1.0"
  },
  "packageManager": "pnpm@10.13.1"
}
